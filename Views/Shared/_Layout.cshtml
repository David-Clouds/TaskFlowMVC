<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - TaskFlow MVC
    </title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <div class="background"></div>

    <header class="navbar">

        <div class="navbar-inner">

            <a asp-controller="Home"
               asp-action="Index"
               class="logo">

                <span class="logo-mark">
                    TF
                </span>

                <span>
                    Task<span>Flow</span>
                </span>

            </a>

            <nav>

                <a asp-controller="Home"
                   asp-action="Index">
                    Inicio
                </a>

                <a asp-controller="Tasks"
                   asp-action="Index">
                    Tareas
                </a>

                <a asp-controller="Tasks"
                   asp-action="Create"
                   class="nav-button">
                    + Crear
                </a>

            </nav>

        </div>

    </header>

    <main>

        @RenderBody()

    </main>

    <footer>

        <div>
            TaskFlow MVC
        </div>

        <div>
            C# · ASP.NET Core · .NET 10 · Git · GitHub
        </div>

    </footer>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>