@model TaskFlowMVC.Models.TaskItem

@{
    ViewData["Title"] = "Nueva tarea";
}

<section class="form-container">

    <div class="form-heading">

        <div class="hero-label">
            NUEVA TAREA
        </div>

        <h1>
            Agrega algo nuevo.
        </h1>

        <p>
            Crea una actividad y define su nivel de prioridad.
        </p>

    </div>

    <div class="form-card">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation">
            </div>

            <div class="form-group">

                <label asp-for="Title">
                    Título
                </label>

                <input asp-for="Title"
                       placeholder="Ej. Terminar proyecto de C#"
                       autocomplete="off" />

                <span asp-validation-for="Title"
                      class="validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Description">
                    Descripción
                </label>

                <textarea asp-for="Description"
                          rows="5"
                          placeholder="Describe brevemente lo que necesitas hacer..."></textarea>

                <span asp-validation-for="Description"
                      class="validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Priority">
                    Prioridad
                </label>

                <select asp-for="Priority">

                    <option value="Alta">
                        Alta
                    </option>

                    <option value="Media">
                        Media
                    </option>

                    <option value="Baja">
                        Baja
                    </option>

                </select>

            </div>

            <div class="form-buttons">

                <a asp-action="Index"
                   class="btn-outline">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-main">
                    Guardar tarea
                </button>

            </div>

        </form>

    </div>

</section>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}